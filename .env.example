# Tolab — environment variables
# Copy this to .env and fill in values for local dev or Docker.

# ── Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tolab
POSTGRES_PASSWORD=tolab
POSTGRES_DB=tolab

# ── Backend
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS (comma-separated origins — use * for dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend (only used by Vite at build/dev time)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/api/v1

# ── Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Storage
STORAGE_DIR=./storage

# ── Logging (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO

# ── CSRF: the frontend sends X-CSRF-Token: tolab-csrf on all mutating requests
#    (no env var needed — hardcoded symmetric token for SPA same-origin protection)

# ── Optional: SMTP for email invites / notifications
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@tolab.dev